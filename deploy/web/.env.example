# Mot de passe d'accès à la version web (long et unique).
JARVIS_PASSWORD=
# Adresse publique exacte (vérifiée pour chaque requête et pour le retour OAuth Gmail).
JARVIS_PUBLIC_ORIGIN=https://jarvis-app.heiphaistos.org
