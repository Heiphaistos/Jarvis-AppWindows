{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS",
  "version": "5.4.0",
  "identifier": "com.jarvis.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "J.A.R.V.I.S.",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI --allow-running-insecure-content",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:8765 http://127.0.0.1:8765; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/jarvis_server.exe": "jarvis_server.exe",
      "../../server/models/piper/piper.exe": "models/piper/piper.exe",
      "../../server/models/piper/espeak-ng.dll": "models/piper/espeak-ng.dll",
      "../../server/models/piper/piper_phonemize.dll": "models/piper/piper_phonemize.dll",
      "../../server/models/piper/onnxruntime.dll": "models/piper/onnxruntime.dll",
      "../../server/models/piper/onnxruntime_providers_shared.dll": "models/piper/onnxruntime_providers_shared.dll",
      "../../server/models/piper/libtashkeel_model.ort": "models/piper/libtashkeel_model.ort",
      "../../server/models/piper/fr_FR-upmc-medium.onnx": "models/piper/fr_FR-upmc-medium.onnx",
      "../../server/models/piper/fr_FR-upmc-medium.onnx.json": "models/piper/fr_FR-upmc-medium.onnx.json",
      "../../server/models/piper/espeak-ng-data/": "models/piper/espeak-ng-data/",
      "../../server/skills/": "skills/"
    }
  }
}
