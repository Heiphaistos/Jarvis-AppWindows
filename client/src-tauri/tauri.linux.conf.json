{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "resources": {
      "resources/jarvis_server.exe": null,
      "resources/jarvis_server": "jarvis_server"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2 | libasound2t64"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ]
      }
    },
    "category": "Utility",
    "shortDescription": "Assistant IA vocal J.A.R.V.I.S.",
    "longDescription": "Assistant IA vocal : cerveau local ou cloud, voix, mémoire, routines, contrôle du bureau et HUD 3D."
  }
}
